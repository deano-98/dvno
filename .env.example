# Public production origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in international digits only, no +, spaces or punctuation.
# Example format only — replace with your real business number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Optional Google Search Console HTML verification token
GOOGLE_SITE_VERIFICATION=
